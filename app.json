{
  "expo": {
    "name": "Küme",
    "slug": "kume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kume-app-icon.png",
    "scheme": "kume",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kume-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aguspascual.kume"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/kume-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Küme acceder a tu galería para adjuntar fotos a los trabajos.",
          "cameraPermission": "Permite a Küme usar tu cámara para tomar fotos de tus trabajos."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite a Küme acceder a tus contactos para importar clientes fácilmente."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "007e3988-2a63-4e46-b114-141663003ab4"
      }
    }
  }
}
