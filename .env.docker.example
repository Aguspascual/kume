# Copiar a .env.docker y reemplazar ambas contraseñas por valores largos y distintos.
# POSTGRES_PASSWORD solo inicializa el contenedor; el API usa APP_DB_PASSWORD.
POSTGRES_PASSWORD=replace-with-a-long-admin-password
APP_DB_PASSWORD=replace-with-a-long-app-password

# Puerto del host publicado por Docker; el API escucha en 8080 dentro del contenedor.
API_PORT=18080
API_BIND_ADDRESS=0.0.0.0

# Orígenes permitidos para clientes web. Las apps móviles nativas no usan CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# Configure the same secret in Kume and the NODUS secret NODUS_KUME_TOKEN.
# Leave empty to keep the monitoring integration disabled (returns HTTP 503).
NODUS_KUME_TOKEN=

# Optional truthful build/deployment/node metadata. Blank values are returned as null/empty.
KUME_APP_VERSION=
KUME_DEPLOYMENT_VERSION=
KUME_NODE_ID=
KUME_NODE_NAME=
KUME_NODE_ROLE=
